  "scripts": {
    "test": "node --test test/*.test.mjs",
    "setup": "node scripts/cli.mjs setup",
    "dry-setup": "node scripts/cli.mjs dry-setup",
    "delete": "node scripts/cli.mjs delete",
    "doctor": "node scripts/cli.mjs doctor",
    "agent-config": "node scripts/cli.mjs agent-config",
    "smoke:isolated": "node scripts/isolated-smoke.mjs",
    "pack:check": "npm pack --dry-run"
  },
  "engines": {
    "node": ">=20.12.0"
  },
  "dependencies": {
    "@clack/prompts": "^1.5.1",
    "picocolors": "^1.1.1",
    "zod": "^4.4.3"
