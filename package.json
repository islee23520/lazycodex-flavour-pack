{
  "name": "@islee23520/lfp",
  "version": "0.3.16",
  "description": "LazyCodex extension plugin — TypeScript-powered model/provider setup and routing guidance for Codex.",
  "type": "module",
  "license": "MIT",
  "author": "islee23520",
  "homepage": "https://linalab.io",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/islee23520/lazycodex-flavour-pack.git"
  },
  "bugs": {
    "url": "https://github.com/islee23520/lazycodex-flavour-pack/issues"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "keywords": [
    "lazycodex",
    "codex",
    "flavour-pack",
    "hooks"
  ],
  "bin": {
    "lfp": "scripts/cli.mjs"
  },
  "exports": {
    ".": "./scripts/cli.mjs"
  },
  "files": [
    ".codex-plugin",
    "agent-configs",
    "agent-overrides",
    "hooks",
    "scripts",
    "dist",
    "README.md"
  ],
  "scripts": {
    "test": "node --import tsx --test test/*.test.ts",
    "build": "rm -rf dist && tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.typecheck.json",
    "lint": "biome check .",
    "format": "biome format --write .",
    "check": "npm run typecheck && npm run lint && npm test",
    "setup": "node scripts/cli.mjs setup",
    "dry-setup": "node scripts/cli.mjs dry-setup",
    "delete": "node scripts/cli.mjs delete",
    "doctor": "node scripts/cli.mjs doctor",
    "agent-config": "node scripts/cli.mjs agent-config",
    "smoke:isolated": "node scripts/isolated-smoke.mjs",
    "pack:check": "npm run build && npm pack --dry-run"
  },
  "engines": {
    "node": ">=20.12.0"
  },
  "dependencies": {
    "@clack/prompts": "^1.5.1",
    "picocolors": "^1.1.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.1",
    "@types/node": "^26.0.0",
    "tsx": "^4.22.4",
    "typescript": "^6.0.3"
  },
  "directories": {
    "test": "test"
  }
}
