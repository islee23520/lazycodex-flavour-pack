{
  "name": "@islee23520/lfp",
  "version": "0.3.15",
  "description": "LazyCodex extension plugin — model/provider setup, category routing guidance, and fallback lookup for Codex.",
  "type": "module",
  "license": "MIT",
  "author": "islee23520",
  "homepage": "https://linalab.io",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/islee23520/lazycodex-flavour-pack.git"
  },
  "bugs": {
    "url": "https://github.com/islee23520/lazycodex-flavour-pack/issues"
  },
  "publishConfig": {
    "access": "public",
