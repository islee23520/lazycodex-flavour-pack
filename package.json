{
  "name": "@islee23520/lfp",
  "version": "0.3.4",
  "description": "LazyCodex flavour pack with lightweight agent override sync.",
  "type": "module",
  "license": "MIT",
  "author": "islee23520",
  "homepage": "https://linalab.io",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/islee23520/lazycodex-flavour-pack.git"
  },
  "bugs": {
    "url": "https://github.com/islee23520/lazycodex-flavour-pack/issues"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "keywords": [
    "lazycodex",
    "codex",
    "flavour-pack",
    "agents",
    "hooks"
  ],
  "bin": {
    "lfp": "scripts/cli.mjs"
  },
  "files": [
    ".codex-plugin",
    "agent-configs",
    "agent-overrides",
    "hooks",
    "scripts",
    "README.md"
  ],
  "scripts": {
    "test": "node --test test/*.test.mjs",
    "setup": "node scripts/cli.mjs setup",
    "dry-setup": "node scripts/cli.mjs dry-setup",
    "doctor": "node scripts/cli.mjs doctor",
    "pack:check": "npm pack --dry-run"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
